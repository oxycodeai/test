# ─── Required ───────────────────────────────────────────────
# Cuelinks publisher API (dashboard → Settings → API). AFFILIATE_MODE=manual bhi chalega bina key ke.
CUELINKS_API_KEY=
CUELINKS_CHANNEL_ID=

# Dashboard PIN — first-run pe web UI se bhi set ho sakta hai
AUTH_PIN=

# ─── Security (optional but recommended) ────────────────────
# 32-byte hex — session storageState AES-256-GCM encrypt karega
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENC_KEY=

# ─── Platform ───────────────────────────────────────────────
# Termux custom chromium path (auto-detect fail ho to)
# CHROMIUM_PATH=/data/data/com.termux/files/usr/bin/chromium

# ─── Tuning ─────────────────────────────────────────────────
PORT=3000
SCAN_CONCURRENCY=2
REQ_DELAY_MIN_MS=2000
REQ_DELAY_MAX_MS=5000

# ─── Mode ───────────────────────────────────────────────────
# cuelinks | manual
AFFILIATE_MODE=cuelinks
# true = Place Order click nahi hota (testing)
CHECKOUT_DRY_RUN=false
# tunnel band karna ho to 0
TUNNEL=1
NODE_ENV=production
